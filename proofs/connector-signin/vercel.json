{
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/metadata" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/metadata" },
    { "source": "/oauth/consent", "destination": "/api/page?p=consent" },
    { "source": "/passkey", "destination": "/api/page?p=passkey" },
    { "source": "/manifest.webmanifest", "destination": "/api/page?p=manifest" },
    { "source": "/", "destination": "/api/page?p=home" }
  ]
}
