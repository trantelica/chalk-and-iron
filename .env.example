# Copy to .env.local for local work, and set the same names in Vercel's
# project settings. Values come from the Supabase dashboard (Settings > API Keys).
# Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. The all-powerful key: used only in src/server/admin-client.ts.
SUPABASE_SECRET_KEY=
# The app's permanent address (decided 17 Nov 2026). Invite and reset links use it.
NEXT_PUBLIC_APP_ORIGIN=https://chalkandiron.vercel.app
# Old addresses that forward to the permanent one, comma-separated.
REDIRECT_FROM_HOSTS=chalkandiron-trantelica.vercel.app
