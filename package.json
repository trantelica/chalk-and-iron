{
  "name": "chalk-and-iron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run tokens && next dev",
    "build": "npm run tokens && next build",
    "start": "next start",
    "tokens": "node scripts/build-tokens.mjs",
    "check": "node scripts/check-no-hardcoded-style.mjs && node scripts/check-no-llm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run tokens && npm run check && vitest run",
    "test:supabase": "vitest run --config vitest.supabase.config.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@types/node": "22.18.8",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "pg": "8.23.1",
    "supabase": "3.2.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
